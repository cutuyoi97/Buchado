# Copia este archivo como .env.local para desarrollo local con `vercel dev`.
# En producción, configura estas mismas variables en Vercel:
# Project Settings > Environment Variables.
# Nunca subas un archivo .env con valores reales al repositorio.

# API key de Resend (Dashboard > API Keys).
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=secretaria@buchado.edu.co

# Remitente que aparecerá en el correo. Debe pertenecer a un dominio
# verificado en Resend (Dashboard > Domains). Mientras no verifiques un
# dominio propio, puedes usar el remitente de pruebas de Resend:
# onboarding@resend.dev
CONTACT_FROM_EMAIL=I.E. Buchadó Fernando Botero Angulo <onboarding@resend.dev>
